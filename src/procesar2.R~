rm(list = ls())
library(xtable)
source('procesar.R')

## Parametros verdaderos
bb_sosa    <- c(0.5, 1)
bb_ay      <- c(0.5, 1)
bb_du      <- c(1, 2)
rango_du   <- c(0, 10)
rango_ay   <- c(0, 1)
rango_sosa <- c(0, 1)
ff_sosa    <- function (x) sin(x * pi / 2)
ff_ay      <- function (x) 10 + 5 * x^2
ff_du      <- function (x) exp(x/4) - 0.5

## Resumo las salidas
carpeta  <- 'pruebas-marzo-AY/'
cuales   <- comunes(carpeta, TRUE)
files    <- list.files(carpeta, full.names = TRUE, recursive = TRUE)
resumen_ayso <- t(sapply(grep('sosa-ay', files, value = TRUE), resumirAY,
                         ff = ff_sosa, bb_sosa, rango_sosa,
                         cuales, plt = FALSE, USE.NAMES = TRUE))

## Exporto la tabla a latex
print(xtable(resumen_ayso, digits = 4))

## Lu - Du ---------------------------------------------------------------------
library(xtable)
library(fda)
source('procesar.R')

## Parametros verdaderos
bb_sosa    <- c(0.5, 1)
rango_sosa <- c(0, 1)
ff_sosa    <- function (x) sin(x * pi / 2)

## Calculo los mejores
carpeta  <- 'pruebas-marzo-lu-huber/'
cuales   <- comunes(carpeta, TRUE)
files    <- list.dirs(carpeta, full.names = TRUE, recursive = FALSE)
lapply(files, mejor, cuales, 'bic')

## Resumo las salidas
carpeta  <- './'
files <- list.files(carpeta, 'bic', full.names = TRUE, recursive = FALSE)
tabla <- t(sapply(files, resumir, ff_sosa, bb_sosa, rango_sosa))

## Exporto la tabla a latex
print(xtable(tabla, digits = 4))




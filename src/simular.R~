source('src/minimizar.R')
source('src/mpl.v7.R')  ## source('src/mpl-pablo.R')


simular <- function (datos, nn, estimate, cont, extra = NULL, poda,
                     from, to, carpeta) {
    
    ## ------------------------- -------------------------------------------
    ## Regresion parcialmente lineal con restricciones de monotonia
    ## ---------------------------------------------------------------------
    ## datos: 'sosa', 'du', 'ay'
    ## nn: sample size
    ## estimate: list with type and other arguments
    ##   if type == nos then
    ##     ven: window size for Alvarez-Yohai estimator
    ##   if type == splines then
    ##     spl : number of splines
    ##     initial: 'cl', 'rb', 'ay'
    ##     fLoss: loss function 'ls', 'huber', 'tukey', 'l1'
    ## cont: contamination scheme 'C0', 'C1', 'C2', 'C3', 'C4'
    ## extra: extra arguments for the contamination scheme
    ## poda: fraccion de poda en cada borde del intervalo para el MISE
    ## from: starting iteration
    ## to: last iteration
    ## carpeta: directorio para guardar las salidas
    ## ---------------------------------------------------------------------
    
    ## Some samples may be discarded
    done <- 0
    iter <- from
    
    while (done <= (to - from)) {
        attempt <- try({
            ## Set seed for reproducibility
            print(c(iter, datos, spl, cont))
            set.seed(iter)
            
            ## Sample and spline basis (unif knots)
            smpl <- generar(datos, nn, cont, extra)
            rr   <- smpl$r
            pp   <- length(smpl$b)
            tt   <- smpl$t

            ## Main estimation
            if (estimate$type == "splines") {  # ludu
                kns  <- seq(min(tt), max(tt), length = estimate$spl - 4 + 2)
                base <- create.bspline.basis(rr, breaks = kns, norder = 4)
                spl_base <- getbasismatrix(tt, base)
                
                ## lmrob control parameters
                control <- lmrob.control(trace.level = 0,
                                         tuning.psi = 3.4434,  # FIX
                                         nResample   = 5000,
                                         subsampling = 'simple',
                                         rel.tol     = 1e-5,
                                         refine.tol  = 1e-5,
                                         k.max       = 2e3,
                                         maxit.scale = 2e3,
                                         max.it      = 2e3)
                
                ## Initial estimates
                if (estimate$initial == 'cl') { # clasico
                    lm_init   <- lm(smpl$y ~ spl_base + smpl$x - 1)
                    par_init  <- lm_init$coeff
                    scl_init  <- 1
                    init_conv <- 2
                }
                if (estimate$initial == 'rb') { # robusto
                    lm_init   <- lmrob(smpl$y ~ spl_base + smpl$x - 1, control = control)
                    par_init  <- lm_init$coeff
                    scl_init  <- lm_init$scale
                    init_conv <- lm_init$init.S$converged
                }
                if (estimate$initial == 'ay') {  # monotono Alvarez-Yohai
                    lm_init   <- monotonopl(smpl$x, smpl$y, smpl$t, estimate$ven)
                    spl_init  <- lmrob(lm_init$g ~ spl_base - 1, control = control)$coeff
                    par_init  <- c(spl_init, lm_init$b)
                    scl_init  <- 1
                    init_conv <- 3
                }

                est <- plisot(smpl$y, smpl$x, spl_base, estimate$fLoss, par_init, scl_init)
                error <- (smpl$g - spl_base %*% est$spl)^2
            }
            
            if (estimate$type == "nos") {  # alvyoh
                est <- mpl(as.matrix(smpl$x), smpl$y, smpl$t, estimate$ven)
                res <- smpl$y - smpl$x %*% est$b - est$g
                s1 <- mad(res)	  
                s2 <- scaleS(res, b = 0.5 , cc = 1.54764)
                error <- (smpl$g[order(smpl$t)] - est$g)^2
            }
            
            ## MISE 
            mise  <- mean(error)
            saco  <- floor(nn * poda)
            cual  <- (1 + saco):(nn - saco)
            mise_podado <- mean(error[cual])

        }, silent = FALSE)

        if (!inherits(attempt, 'try-error')) {
            ## Increase the number of successful iterations
            done <- done + 1
            
            ## Save data
            if (!dir.exists(carpeta)) dir.create(carpeta)

            ## Check estimate
            if (estimate$type == "nos") {
                file_name <- paste(estimate$initial, estimate$fLoss,
                                   'n', nn, from, to, 'cont', cont,
                                   'extra', extra, 'spl', estimate$spl,
                                   sep = '-')

                to_write  <- c(iter, init_conv, est$conv, nn, pp,
                               estimate$spl, mise, mise_podado, est$scl,
                               est$val, est$lm, est$spl)
                
                aux <- paste(datos, estimate$initial, estimate$fLoss,
                             'n', nn, 'cont', cont, sep = '-')
                folder_name <- paste(carpeta, aux, sep = '/')
            }
            if (estimate$type == "ludu") {
                file_name <- paste('ay', 'n', nn, from, to, 'cont',
                                   cont, 'extra', extra, 'ven',
                                   estimate$ven, sep = '-')

                to_write  <- c(iter, s1, s2, mise, mise_podado, est$b,
                               est$g)

                aux <- paste(datos, 'ay', 'n', nn, 'out', out, 'ven',
                             ven, sep = '-')
                folder_name <- paste(carpeta, aux, sep = '/')
            }
            if (!dir.exists(folder_name)) dir.create(folder_name)
            write(to_write, paste(folder_name, '/', file_name, '.txt',
                                  sep = ''),
                  append = TRUE, ncol = length(to_write))
        }
    }
    ## Next iteration...
    iter <- iter + 1
}


scaleS <- function(u, b = 0.5 , cc = 1.54764) {
    ## find the scale, full iterations
    max.it <- 200
    sc     <- median(abs(u)) / 0.6745
    i      <- 0
    eps    <- 1e-20
    ## magic number alert
    err <- 1
    while (((i <- i + 1) < max.it) && (err > eps)) {
        sc2 <- sqrt(sc^2 * mean(Mchi(u / sc, cc, psi = 'bisquare')) / b)
        err <- abs(sc2 / sc - 1)
        sc  <- sc2
    }
    return(sc)
}

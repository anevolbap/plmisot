## --------------------------------------------
## Generates contaminated data following
##
##        y = x * b + g(t) + error
## --------------------------------------------
## nn     : sample size
## bb     : true parametric term
## modelo : non-parametric term 'm1', 'm2', 'm3'
## out    : contamination scheme 'C0','C1','C2'
## --------------------------------------------

generar <- function (nn, bb, modelo, out) {
    tt <- runif(nn, 0, 10)
    x1 <- rnorm(nn)
    x2 <- rbinom(nn, 1, 0.5)
    xx <- cbind(x1, x2)
    gg <- exp(tt / 4) - 0.5
    
    ## Contamination and errors
    oo <- NULL
    if (out == 'C0') ee <- rnorm(nn, 0, 0.5)
    if (out == 'C1') ee <- rt(nn, 3)
    if (out == 'C2') ee <- rcauchy(nn)
   
    ## Response
    yy <- xx %*% bb + gg + ee

    return(list(y = yy, x = xx, t = tt,
                g = gg, e = ee, out = oo))
}
